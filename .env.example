APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Laravel Reverb (servidor de WebSockets) ---
# REVERB_HOST es la dirección que usa LARAVEL para publicar eventos en Reverb.
# Como Laravel y Reverb corren en la misma computadora, queda en "localhost".
# (Las tablets NO usan este valor: se conectan a la IP desde la que abrieron la página.)
REVERB_APP_ID=123456
REVERB_APP_KEY=miclavereverb
REVERB_APP_SECRET=misecretoreverb
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- La Carrera de Multiplicar ---
# Dirección que se muestra en el proyector y en el QR. Vacía = se detecta sola.
# AULA_URL=http://192.168.0.15:8000/alumno

# --- Modo internet (Cloudflare Tunnel / Laravel Cloud) ---
# Clave para que la docente use los controles desde otra compu o por internet.
DOCENTE_CLAVE=
# Proxies de confianza (ver config/trustedproxy.php). Con el túnel: 127.0.0.1,::1
# En el aula y en Laravel Cloud se deja vacío.
TRUSTED_PROXIES=
# Dirección pública de Reverb para el navegador (solo con Cloudflare Tunnel).
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=
